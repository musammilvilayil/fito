# ---------------------------------------------------------------------------
# FITO environment variables. Copy to .env.local for development.
# Never commit real values. In production set these in your host's dashboard.
# ---------------------------------------------------------------------------

# Database connection used by the running app. It must use the `fito_app`
# role (not the table owner) so that row-level security isolates gyms.
DATABASE_URL=postgres://fito_app:CHANGE_ME@localhost:5432/fito

# Owner/admin connection, used ONLY by `npm run db:migrate` and seed scripts.
# Do not give this to the running app.
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/fito

# Public base URL of the app, without a trailing slash. Used for invite and
# password-reset links and for cross-site request checks.
APP_URL=http://localhost:3000

# When set, creating a new gym at /register requires this code.
# Strongly recommended in production during the pilot.
SIGNUP_ACCESS_CODE=

# AI workout generation (optional). Without a key, FITO generates plans from
# its rule-based template engine and labels them as templates.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Default monthly cap on AI generations per gym (cost control).
AI_MONTHLY_LIMIT_DEFAULT=100

# Where exercise images are served from. Defaults to the public-domain
# free-exercise-db repository; point it at your own mirror/CDN later.
EXERCISE_MEDIA_BASE_URL=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/

# Max database connections per server instance (keep low on serverless).
DATABASE_POOL_MAX=5

# debug | info | warn | error
LOG_LEVEL=info
